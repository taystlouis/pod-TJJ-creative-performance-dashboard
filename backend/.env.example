# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pod_tjj_dashboard

# Asana
ASANA_TOKEN=your_asana_personal_access_token

# Looker Data Source (choose ONE):
# Option 1: Looker API key (if you have one)
LOOKER_API_KEY=

# Option 2: Google Sheets export (share CSV publicly)
# Steps: 1. Export Looker data to Google Sheet
#        2. File > Share > Anyone with link > Viewer
#        3. Get the sheet ID from URL (between /d/ and /edit)
LOOKER_SHEET_ID=

# Server
PORT=5000
NODE_ENV=development
